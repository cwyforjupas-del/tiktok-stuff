import pandas as pd
import requests
from bs4 import BeautifulSoup
import re
import time

# Define default constants
DEFAULT_PRICE = 0.0
DEFAULT_WEIGHT = 0.0
DEFAULT_LENGTH = 0.0
DEFAULT_WIDTH = 0.0
DEFAULT_HEIGHT = 0.0

def scrape_collection_page(collection_url):
    """
    Scrape all product URLs from a Bauhaus collection page
    Handles pagination if needed
    """
    product_urls = []
    base_url = "https://www.bauhaus.com.hk"
    
    try:
        headers = {
            'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36'
        }
        response = requests.get(collection_url, headers=headers, timeout=10)
        response.encoding = 'utf-8'
        soup = BeautifulSoup(response.content, 'html.parser')
        
        # Find all product links (adjust selector based on actual HTML structure)
        product_links = soup.find_all('a', class_='product-item-meta')  # Adjust class if needed
        
        for link in product_links:
            href = link.get('href')
            if href:
                full_url = href if href.startswith('http') else base_url + href
                product_urls.append(full_url)
        
        print(f"Found {len(product_urls)} products in collection")
        return product_urls
    
    except Exception as e:
        print(f"Error scraping collection: {e}")
        return []

def scrape_bauhaus_product(product_url):
    """
    Scrape product data from a Bauhaus product page
    Extracts data from meta tags and HTML content
    """
    try:
        headers = {
            'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36'
        }
        response = requests.get(product_url, headers=headers, timeout=10)
        response.encoding = 'utf-8'
        soup = BeautifulSoup(response.content, 'html.parser')
        
        product_data = {}
        
        # Extract from Open Graph meta tags
        product_data['title'] = soup.find('meta', property='og:title')
        product_data['title'] = product_data['title']['content'] if product_data['title'] else "Unknown"
        
        product_data['description'] = soup.find('meta', property='og:description')
        product_data['description'] = product_data['description']['content'] if product_data['description'] else ""
        
        product_data['image_url'] = soup.find('meta', property='og:image:secure_url')
        product_data['image_url'] = product_data['image_url']['content'] if product_data['image_url'] else ""
        
        product_data['price'] = soup.find('meta', property='og:price:amount')
        product_data['price'] = float(product_data['price']['content']) if product_data['price'] else DEFAULT_PRICE
        
        # Extract dimensions from the description or metafield
        dimensions = extract_dimensions(soup, product_data['description'])
        product_data['length'] = dimensions.get('length', DEFAULT_LENGTH)
        product_data['width'] = dimensions.get('width', DEFAULT_WIDTH)
        product_data['height'] = dimensions.get('height', DEFAULT_HEIGHT)
        
        return product_data
    
    except Exception as e:
        print(f"Error scraping {product_url}: {e}")
        return None

def extract_dimensions(soup, description):
    """
    Extract dimensions from metafield or description text
    Looks for pattern: "32 x 8 x 24.5 厘米" or similar
    """
    dimensions = {'length': DEFAULT_LENGTH, 'width': DEFAULT_WIDTH, 'height': DEFAULT_HEIGHT}
    
    # Try to find metafield with dimensions
    metafield = soup.find('span', class_='metafield-multi_line_text_field')
    if metafield:
        text = metafield.get_text()
    else:
        text = description
    
    # Pattern: numbers separated by x (handles both English and Chinese)
    pattern = r'(\d+\.?\d*)\s*[xX×]\s*(\d+\.?\d*)\s*[xX×]\s*(\d+\.?\d*)'
    match = re.search(pattern, text)
    
    if match:
        dimensions['length'] = float(match.group(1))
        dimensions['width'] = float(match.group(2))
        dimensions['height'] = float(match.group(3))
    
    return dimensions

